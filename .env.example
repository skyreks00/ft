# Developer configuration for the ft CLI. Copy to .env (gitignored).
# Only PUBLIC values go here: the client secret lives in the broker only.

# UID of the 42 app (https://profile.intra.42.fr/oauth/applications)
FT_CLIENT_ID=
# Token broker: `make broker-dev` serves it on http://localhost:8787
FT_BROKER_URL=http://localhost:8787
# Optional: preferred redirect URI (the registered :8080/:8081/:8082 ones are fallbacks)
FT_REDIRECT_URI=http://localhost:8080/callback

# Optional: your intra login (otherwise read from /v2/me)
FT_LOGIN=

# Optional: evaluation slots platform for your campus (42 Belgium uses
# https://slots.42belgium.be automatically). "intra" forces the intra.
FT_SLOTS_URL=

# Optional: TUI reminders before evaluations and events (default 15m, "off"),
# and whether they also go to the desktop (notify-send / macOS; "off").
FT_REMIND=
FT_NOTIFY=
